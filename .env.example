# Copy to .env and fill in. Every value here has a working local default unless marked REQUIRED IN PRODUCTION.

# development | test | production
APP_ENV=development
# Public address of the app. Must be https:// in production.
APP_BASE_URL=http://localhost:8000

# Postgres (docker-compose.yml). The app role owns nothing so row-level security applies; the owner runs migrations.
# REQUIRED IN PRODUCTION
DATABASE_URL=postgresql+psycopg://seosys_app:seosys_app_local@127.0.0.1:5432/seosys
DATABASE_OWNER_URL=postgresql+psycopg://seosys_owner:seosys_owner_local@127.0.0.1:5432/seosys
DB_POOL_SIZE=5

# Encrypts Google tokens, two-step secrets and website keys. 32 random bytes, base64.
# Make one with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# REQUIRED IN PRODUCTION. When rotating, move the old key to APP_ENCRYPTION_KEYS_OLD as v1=<key> and bump the version.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
APP_ENCRYPTION_KEYS_OLD=

# Email. Locally Mailpit catches everything at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=SEOSys <no-reply@seosys.local>

# Stripe (test mode keys start with sk_test_). Webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for each package (price_...).
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_LOCAL=
STRIPE_PRICE_GROWTH=

# First admin account, created by `python -m seo_platform seed` (start.bat runs it).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: use Claude to write titles, descriptions, alt text and report summaries.
# Without a key the platform uses a built-in template writer and runs fully offline.
ANTHROPIC_API_KEY=
SEO_LLM_MODEL=claude-haiku-5-5

# Demo client website (development only) and the shared key its plugin checks on every request.
DEMO_SITE_URL=http://127.0.0.1:8001
DEMO_SITE_SECRET=local-dev-secret-change-me
# DEMO_SITE_STATE=C:\Users\you\AppData\Local\ProjectSEOSys\site_state.json

# Crawling localhost is needed for the demo. Must be false in production (blocks private addresses).
ALLOW_PRIVATE_HOSTS=true
CRAWL_MAX_PAGES=50
CLIENT_MONTHLY_BUDGET_USD=80

# Google: Search Console + GA4 + sign-in (OAuth web client) and PageSpeed Insights (API key).
# The redirect URI must match the one registered on the OAuth client exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
GOOGLE_PAGESPEED_API_KEY=
