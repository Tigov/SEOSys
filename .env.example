# Copy to .env (or set these in your shell) to change defaults. All are optional.

# Optional: use Claude to write titles, descriptions, alt text and report summaries.
# Without a key the platform uses a built-in template writer and runs fully offline.
ANTHROPIC_API_KEY=
SEO_LLM_MODEL=claude-haiku-5-5

# Where the demo client website runs and the shared key its "plugin" checks on every request.
DEMO_SITE_URL=http://127.0.0.1:8001
DEMO_SITE_SECRET=local-dev-secret-change-me

# Local data (the start script puts these outside OneDrive automatically).
# SEO_DB_PATH=C:\Users\you\AppData\Local\ProjectSEOSys\seo_platform.db
# DEMO_SITE_STATE=C:\Users\you\AppData\Local\ProjectSEOSys\site_state.json

# Crawling localhost is needed for the demo. Set to false to block private addresses (production behaviour).
ALLOW_PRIVATE_HOSTS=true
CRAWL_MAX_PAGES=50
CLIENT_MONTHLY_BUDGET_USD=80
SEED_DEMO_CLIENT=true

# Google: Search Console + GA4 (OAuth web client) and PageSpeed Insights (API key).
# The redirect URI must match the one registered on the OAuth client exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/google/callback
GOOGLE_PAGESPEED_API_KEY=
